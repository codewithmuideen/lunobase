# Copy to .env.local and fill in. NEVER commit real secrets.

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Resend (verify lunobase.com under Resend -> Domains)
RESEND_API_KEY=re_...
EMAIL_FROM="Lunobase <no-reply@lunobase.com>"
SUPPORT_EMAIL=support@lunobase.com
ADMIN_EMAIL=you@example.com

# Random 48+ char secret: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Cloudflare Turnstile (dash.cloudflare.com -> Turnstile). Test keys below always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Optional: CoinGecko demo API key for higher rate limits
COINGECKO_API_KEY=

NEXT_PUBLIC_SITE_URL=https://lunobase.com
